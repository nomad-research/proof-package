 "bounds": [
  {
   "id": "b.reactor_written_report",
   "subject": "licensed_reactor_written_report",
   "quantity": "statutory_report_days",
   "value": 60,
   "unit": "days",
   "source_document": "10 CFR 50.73(a)(1): a licensee event report is submitted within 60 days after discovery of the event",
   "knowable_from": "2000-01-01"
  },
  {
   "id": "b.current_report",
   "subject": "domestic_listed_issuer",
   "quantity": "current_report_days",
   "value": 6,
   "unit": "days",
   "source_document": "Form 8-K General Instruction B.1: filed within four business days of the event (six calendar days used as the bound)",
   "knowable_from": "2004-08-23"
  },
  {
   "id": "b.war_risk_notice",
   "subject": "marine_war_risk_policy",
   "quantity": "notice_period_days",
   "value": 7,
   "unit": "days",
   "source_document": "Institute War and Strikes Clauses (Hulls-Time), cancellation on 7 days' notice",
   "knowable_from": "2000-01-01"
  }
 ],
 "library_rules": [
  {
   "id": "lib.novelty_channels",
   "text": "Novelty belongs to channels, not events",
   "forbids": "novelty attributed to an event rather than its channel",
   "layer": "sequence",
   "carries": [
    "ordering"
   ]
  },
  {
   "id": "lib.recurring_weather",
   "text": "Recurring disruption is priced as weather",
   "forbids": "a lag on a recurring disruption",
   "layer": "sequence",
   "carries": [
    "absence",
    "magnitude"
   ]
  },
  {
   "id": "lib.late_crisis_resolution",
   "text": "Late in a crisis the neglected side is resolution",
   "forbids": "late-crisis moves concentrated on escalation",
   "layer": "sequence",
   "carries": [
    "ordering"
   ]
  },
  {
   "id": "lib.headline_names_reopened",
   "text": "The headline names what reopened, not what stayed shut",
   "forbids": "a reopening headline implying the whole node reopened",
   "layer": "sequence",
   "carries": [
    "map"
   ]
  },
  {
   "id": "lib.repeat_filer_base_rate",
   "text": "A repeat filer gets the base-rate procedure, not the form of its last filing",
   "forbids": "predicting a filing's form from the filer's last one",
   "layer": "sequence",
   "carries": [
    "map",
    "occurrence"
   ]
  },
  {
   "id": "lib.cut_into_glut_silent",
   "text": "A cut into a glut is silent",
   "forbids": "a price response to a supply cut absorbed by slack",
   "layer": "transmission",
   "carries": [
    "absence"
   ]
  },
  {
   "id": "lib.hardest_substitution",
   "text": "The move is largest where substitution is hardest",
   "forbids": "the largest move where substitutes are easy",
   "layer": "transmission",
   "carries": [
    "magnitude",
    "ordering"
   ]
  },
  {
   "id": "lib.toll_booth_first",
   "text": "The toll booth learns before the cargo",
   "forbids": "the cargo owner learning before the node operator",
   "layer": "transmission",
   "carries": [
    "ordering"
   ]
  },
  {
   "id": "lib.constraint_prices_slowest",
   "text": "Constraint prices de-escalate slowest",
   "forbids": "constraint premia unwinding before flows",
   "layer": "transmission",
   "carries": [
    "ordering",
    "duration"
   ]
  },
  {
   "id": "lib.tide_prices_everything",
   "text": "A tide sets the price of everything it touches; events under it are visible only in what the tide does not price",
   "forbids": "attributing a tide move to an event",
   "layer": "transmission",
   "carries": [
    "magnitude"
   ]
  },
  {
   "id": "lib.catalyst_not_node_is_tide",
   "text": "A catalyst that does not concern the node is a tide",
   "forbids": "counting a non-node catalyst as an ACK",
   "layer": "transmission",
   "carries": [
    "occurrence"
   ]
  },
  {
   "id": "lib.toxic_release_shared_space",
   "text": "A toxic release closes the shared space, not the failed asset",
   "forbids": "a release closing only the failed asset",
   "layer": "transmission",
   "carries": [
    "map"
   ]
  },
  {
   "id": "lib.availability_no_constraint_price",
   "text": "An availability failure consumes nothing and leaves nothing short; it has no constraint price",
   "forbids": "citing constraint-price, toll-booth or allocation rules on an event that withholds no consumable",
   "layer": "transmission",
   "carries": [
    "absence"
   ]
  },
  {
   "id": "lib.wounded_owner_premium",
   "text": "The wounded owner of the substitutes collects its own scarcity premium",
   "forbids": "the owner of the failed asset losing when it owns the substitutes",
   "layer": "ownership",
   "carries": [
    "magnitude"
   ]
  },
  {
   "id": "lib.equity_visibility",
   "text": "Equity visibility = event size / ambient tide",
   "forbids": "an equity reaction below the tide's noise",
   "layer": "ownership",
   "carries": [
    "absence",
    "magnitude"
   ]
  },
  {
   "id": "lib.no_pure_play_spectacle",
   "text": "A lag without a listed pure-play is a spectacle, not an edge",
   "forbids": "claiming an edge with no listed pure-play",
   "layer": "ownership",
   "carries": [
    "occurrence"
   ]
  },
  {
   "id": "lib.larger_operator_prior",
   "text": "When an event names a site with more than one operator, the larger operator is the prior",
   "forbids": "attributing a multi-operator site event to the smaller operator by default",
   "layer": "map",
   "carries": [
    "map"
   ]
  },
  {
   "id": "lib.account_precedes_the_rebate",
   "text": "An operator of shared infrastructure under an availability commitment must publish an account of a multi-tenant failure, and the account precedes the money",
   "forbids": "money moving before the account",
   "layer": "candidate",
   "carries": [
    "ordering",
    "occurrence"
   ]
  },
  {
   "id": "lib.junction_shared_node",
   "text": "Unrelated stories correlate only where they share a constrained node",
   "forbids": "a junction with no shared node behind it",
   "layer": "candidate",
   "carries": [
    "ordering"
   ]
  }
 ],
