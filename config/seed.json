 "obligation_templates": [
  {
   "id": "obl.written_event_report",
   "node_types": [
    "power_reactor"
   ],
   "text": "A licensee that made an immediate notification of a reportable event, under a regime requiring a written follow-up, must file the written report within the statutory window.",
   "roles": [
    {
     "role": "licensee",
     "requires_attribute": "licensed_facility"
    }
   ],
   "conditions": [
    {
     "role": "licensee",
     "attribute": "licensed_facility",
     "op": "==",
     "value": "true"
    },
    {
     "role": "licensee",
     "attribute": "reportable_event_notified",
     "op": "==",
     "value": "true"
    }
   ],
   "forces": "written_event_report",
   "carrier_kinds": [
    "regulator_docket"
   ],
   "window_rule": {
    "kind": "statute",
    "subject": "licensed_reactor_written_report",
    "quantity": "statutory_report_days"
   },
   "forbids": "no written event report of this kind without a reportable-event notification by a licensee under the regime"
  },
  {
   "id": "obl.unit_status_publication",
   "node_types": [
    "power_reactor",
    "power_plant"
   ],
   "text": "A unit taken offline, under a regulator that publishes every unit's status daily, must appear either restarted or still down in each daily report; its return to service is published.",
   "roles": [
    {
     "role": "operator",
     "requires_attribute": "unit_status"
    }
   ],
   "conditions": [
    {
     "role": "operator",
     "attribute": "unit_status",
     "op": "in",
     "value": [
      "offline",
      "reduced"
     ]
    },
    {
     "role": "operator",
     "attribute": "daily_status_published",
     "op": "==",
     "value": "true"
    }
   ],
   "forces": "restart_status",
   "carrier_kinds": [
    "daily_unit_status"
   ],
   "window_rule": {
    "kind": "none"
   },
   "forbids": "no published return to service without a unit that was offline or reduced"
  },
  {
   "id": "obl.material_event_current_report",
   "node_types": [
    "power_reactor",
    "power_plant",
    "refinery",
    "smelter",
    "port",
    "pipeline",
    "lng_terminal",
    "chemical_plant",
    "mine",
    "strait",
    "data_centre",
    "cloud_region"
   ],
   "text": "A listed issuer for which an event is material must file a current report within the statutory window.",
   "roles": [
    {
     "role": "issuer",
     "holder_classes": [
      "listed_instrument"
     ],
     "requires_attribute": "listed_domestic_filer"
    }
   ],
   "conditions": [
    {
     "role": "issuer",
     "attribute": "listed_domestic_filer",
     "op": "==",
     "value": "true"
    },
    {
     "role": "issuer",
     "attribute": "event_impact_share",
     "op": ">=",
     "value": 0.05
    }
   ],
   "forces": "current_report",
   "carrier_kinds": [
    "securities_filings"
   ],
   "window_rule": {
    "kind": "statute",
    "subject": "domestic_listed_issuer",
    "quantity": "current_report_days"
   },
   "forbids": "no current report of this kind without an event material to the issuer"
  },
  {
   "id": "obl.force_majeure_notice",
   "node_types": [
    "smelter",
    "refinery",
    "mine",
    "lng_terminal",
    "chemical_plant",
    "power_plant",
    "pipeline",
    "port"
   ],
   "text": "A supplier that can't deliver contracted offtake, with no substitute inside the window and buyers' inventory below the window, must notify its counterparties.",
   "roles": [
    {
     "role": "supplier",
     "requires_attribute": "capacity_lost_share"
    },
    {
     "role": "buyer",
     "requires_attribute": "contract_type"
    }
   ],
   "conditions": [
    {
     "role": "supplier",
     "attribute": "capacity_lost_share",
     "op": ">=",
     "value": 0.5
    },
    {
     "role": "buyer",
     "attribute": "contract_type",
     "op": "==",
     "value": "offtake"
    },
    {
     "role": "supplier",
     "attribute": "substitute_lead_days",
     "op": ">",
     "value": {
      "ref": "window_days"
     }
    },
    {
     "role": "buyer",
     "attribute": "inventory_days",
     "op": "<",
     "value": {
      "ref": "window_days"
     }
    }
   ],
   "forces": "force_majeure",
   "carrier_kinds": [
    "counterparty_notice",
    "securities_filings"
   ],
   "window_rule": {
    "kind": "none"
   },
   "forbids": "no force-majeure notice without a contracted offtake the supplier can't serve inside the window"
  },
  {
   "id": "obl.allocation_notice",
   "node_types": [
    "smelter",
    "refinery",
    "mine",
    "lng_terminal",
    "chemical_plant",
    "pipeline"
   ],
   "text": "A supplier short of contracted volume with several contracted buyers must allocate and notify the allocation.",
   "roles": [
    {
     "role": "supplier",
     "requires_attribute": "capacity_lost_share"
    }
   ],
   "conditions": [
    {
     "role": "supplier",
     "attribute": "capacity_lost_share",
     "op": ">",
     "value": 0.0
    },
    {
     "role": "supplier",
     "attribute": "contracted_buyers",
     "op": ">=",
     "value": 2
    },
    {
     "role": "supplier",
     "attribute": "inventory_days",
     "op": "<",
     "value": {
      "ref": "window_days"
     }
    }
   ],
   "forces": "allocation_notice",
   "carrier_kinds": [
    "counterparty_notice"
   ],
   "window_rule": {
    "kind": "none"
   },
   "forbids": "no allocation notice without a shortfall across several contracted buyers"
  },
  {
   "id": "obl.regulator_decision",
   "node_types": [
    "power_reactor",
    "power_plant",
    "pipeline",
    "port",
    "lng_terminal",
    "strait",
    "sovereign_debt",
    "central_bank_facility"
   ],
   "text": "A regulator with a pending application under a statutory decision window must answer inside it.",
   "roles": [
    {
     "role": "applicant",
     "requires_attribute": "pending_application"
    }
   ],
   "conditions": [
    {
     "role": "applicant",
     "attribute": "pending_application",
     "op": "==",
     "value": "true"
    }
   ],
   "forces": "regulatory_decision",
   "carrier_kinds": [
    "regulator_docket"
   ],
   "window_rule": {
    "kind": "none"
   },
   "forbids": "no regulatory decision of this kind without a pending application"
  },
  {
   "id": "obl.war_risk_notice",
   "node_types": [
    "strait",
    "port",
    "shipping_lane"
   ],
   "text": "An insurer covering transits of a node that becomes a declared risk area must give notice of cancellation or re-rating within its policy notice period.",
   "roles": [
    {
     "role": "insurer",
     "requires_attribute": "covers_node_transit"
    }
   ],
   "conditions": [
    {
     "role": "insurer",
     "attribute": "covers_node_transit",
     "op": "==",
     "value": "true"
    },
    {
     "fact": "constrained"
    }
   ],
   "forces": "war_risk_notice",
   "carrier_kinds": [
    "market_notice"
   ],
   "window_rule": {
    "kind": "statute",
    "subject": "marine_war_risk_policy",
    "quantity": "notice_period_days"
   },
   "forbids": "no war-risk notice without covered transits of a constrained node"
  },
  {
   "id": "obl.sovereign_payment",
   "node_types": [
    "sovereign_debt"
   ],
   "text": "A sovereign with a coupon due inside the window must pay, pay in grace, or miss; the payment status is published.",
   "roles": [
    {
     "role": "issuer",
     "entity_kinds": [
      "sovereign"
     ],
     "requires_attribute": "coupon_due_days"
    }
   ],
   "conditions": [
    {
     "role": "issuer",
     "attribute": "coupon_due_days",
     "op": "<=",
     "value": {
      "ref": "window_days"
     }
    }
   ],
   "forces": "sovereign_payment",
   "carrier_kinds": [
    "paying_agent_notice"
   ],
   "window_rule": {
    "kind": "none"
   },
   "forbids": "no payment status notice without a coupon falling due"
  },
  {
   "id": "obl.replacement_procurement",
   "node_types": [
    "power_reactor",
    "power_plant"
   ],
   "text": "An owner with an obligation to serve load, whose owned share of an offline unit exceeds its uncommitted capacity, must buy replacement energy or capacity for the outage.",
   "roles": [
    {
     "role": "owner",
     "requires_attribute": "owns_unit"
    }
   ],
   "conditions": [
    {
     "role": "owner",
     "attribute": "owns_unit",
     "op": "==",
     "value": "true"
    },
    {
     "role": "owner",
     "attribute": "obligation_to_serve",
     "op": "==",
     "value": "true"
    },
    {
     "role": "owner",
     "attribute": "uncommitted_capacity_share",
     "op": "<",
     "value": 1.0
    }
   ],
   "forces": "replacement_cost_disclosure",
   "carrier_kinds": [
    "regulator_docket",
    "securities_filings"
   ],
   "window_rule": {
    "kind": "none"
   },
   "forbids": "no replacement-cost disclosure without an obligated owner short of uncommitted capacity"
  }
 ],
